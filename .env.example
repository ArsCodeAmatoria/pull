# Application
# Local: http://localhost:3001 | Vercel: https://pull-saas.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Ridgetechone"

# CCA teaching aid (Go API)
# Local: point Next at the Go API. On Vercel set CCA_API_URL to the Fly URL
# (https://ridgetechone-cca.fly.dev) so class-day/CCA hit Go; leave unset to
# use CCA_DATABASE_URL directly for login-only.
CCA_API_URL="http://127.0.0.1:8080"
NEXT_PUBLIC_CCA_API_URL="http://127.0.0.1:8080"
# Use the same Supabase Postgres as DATABASE_URL / DIRECT_URL (session port 5432, not pgbouncer 6543).
CCA_DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"
CCA_JWT_SECRET="dev-change-me-cca-jwt"
INSTRUCTOR_BOOTSTRAP_PASSWORD="changeme"
CCA_ARCHIVE_EMAIL="credentials@localhost"
CCA_BRANCH_EMAIL=""
CCA_DATA_DIR="./data"
TEMPORAL_ADDRESS=""
TEMPORAL_NAMESPACE="pull-cca"

# Database (Supabase Postgres) — shared with Proven, same project (local + production).
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public&sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public&sslmode=require&uselibpqcompat=true"

# Supabase Auth — same project/keys as Proven (local .env and Vercel Production).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
